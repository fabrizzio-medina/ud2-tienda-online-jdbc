# Copia este fichero en src/main/resources/application.properties y pon tus datos
# database.engine: MYSQL | H2
# connection.mode: DRIVER_MANAGER | POOL
# simulation.mode: NORMAL | FALLO_TRANSACCION
database.engine=MYSQL
connection.mode=DRIVER_MANAGER
simulation.mode=NORMAL

db.mysql.url=jdbc:mysql://localhost:3306/unidad2
db.mysql.user=TU_USUARIO
db.mysql.password=TU_CONTRASEÑA
db.mysql.driver=com.mysql.cj.jdbc.Driver

db.h2.url=jdbc:h2:mem:unidad2;MODE=MySQL;DB_CLOSE_DELAY=-1
db.h2.user=sa
db.h2.password=
db.h2.driver=org.h2.Driver